<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug Log viewer screen for AdMuter.

    Provides a scrollable monospace viewer for the in-memory
    [DebugEventLog] buffer, plus diagnostic actions:
      - "Simulate Ad Detection" — fires an AD_DETECTED broadcast to
        MuterService so the mute/restore pipeline can be verified
        without waiting for a real Spotify ad (moved here from the
        main dashboard).
      - "Copy Log" / "Clear Log" — clipboard export & buffer reset.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Debug Logs"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Close (back to dashboard) -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Log viewer -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#FF1A1A2E"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp" />

    <!-- Simulate Ad Detection -->
    <Button
        android:id="@+id/btnSimulateAd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Simulate Ad Detection"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_target"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <!-- Copy / Clear row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopyLog"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Copy Log"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnClearLog"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Clear Log"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
