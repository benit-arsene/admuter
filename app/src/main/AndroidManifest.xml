<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission to control audio volume -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Permission to post persistent notification for the foreground service -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Base permission required for any foreground service (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Permission for foreground service with specialUse type (required on Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Required on Android 11+ to query whether Spotify is installed.
         Without this, getPackageInfo("com.spotify.music") throws
         NameNotFoundException even when Spotify is installed. -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <!-- BIND_NOTIFICATION_LISTENER_SERVICE is NOT declared as uses-permission
         to avoid Google Play Protect blocking installation. It's only set on
         the service tag below (android:permission), which is sufficient for
         the system to bind to it. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdMuter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AdMuter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DebugLogActivity"
            android:exported="false"
            android:label="Debug Logs"
            android:theme="@style/Theme.AdMuter" />

        <service
            android:name=".MuterService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automated system audio muting for media ad detection broadcasts" />
        </service>

        <!-- SpotifyNotificationListener — single consolidated listener that
             detects Spotify ads from notification text with CATEGORY_TRANSPORT
             filtering to avoid false positives from non-media notifications.
             User must enable in Settings → Notification Access.
             exported="true" is required so the system can bind to it. -->
        <service
            android:name=".SpotifyNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
